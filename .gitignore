# Device survey output from tools/oneseg-probe.sh.
# This is a copy of someone's /system plus their partition map - it does not
# belong in a public repository, and parts of it are not redistributable.
oneseg-report/
*.img
efs.img
system.img

# Proprietary blobs extracted from a stock ROM. Never commit these.
vendor/
proprietary/
*.apk
*.so
*.jar

# Build output
out/
*.zip

# A LineageOS tree does not belong in here - repo init goes in a separate
# directory entirely (docs/03 section 3, and tools/link-device-tree.sh
# refuses to point at this one). These are here so that a mistake stays
# invisible to git rather than burying the project in untracked files.
.repo/
build/
frameworks/
prebuilts/
external/
system/
bionic/
art/
libcore/
packages/
hardware/
kernel/samsung/

# Editors and OS
*.swp
*~
.DS_Store
__pycache__/
*.pyc
